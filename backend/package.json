{
  "name": "payment-checkout-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "oxlint src",
    "test": "jest --runInBand",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.12.0",
    "ajv": "8.18.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "fastify": "5.12.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.6",
    "jest": "29.7.0",
    "js-yaml": "4.3.2",
    "oxlint": "1.85.0",
    "prisma": "6.12.0",
    "ts-jest": "29.4.5",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fastify": "5.12.5"
  }
}
